{
  "name": "wl2go",
  "version": "0.1.0",
  "description": "All-in-one Winlink email client for amateur radio",
  "main": "out/main/index.js",
  "author": "WL2GO contributors",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/jkmurre/WL2GO#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkmurre/WL2GO.git"
  },
  "bugs": {
    "url": "https://github.com/jkmurre/WL2GO/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "build:pat": "bash scripts/build-pat.sh",
    "build:ardopcf": "bash scripts/build-ardopcf.sh",
    "build:rigctld": "bash scripts/build-rigctld.sh",
    "find-menu-address": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/find-civ-menu-address.mjs",
    "decode-rx-wav": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/decode-rx-wav.mjs",
    "pack:mac": "electron-vite build && bash scripts/pack-mac.sh",
    "bootstrap": "npm install && npm run build:pat && npm run build:ardopcf && npm run build:rigctld && npm run build && npm run pack:mac"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^43.8.10",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.6.0",
    "vite": "7.3.7"
  },
  "dependencies": {
    "react-window": "^2.5.3",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
