@@ -160,6 +160,9 @@ int send_retries = 0;  // number of unsuccessfull retry attempts.
 bool retry_is_http = false;
 
 char ws_port_str[7] = "8088";  // Default.  Can be changed with ws_set_port()
+// Address the listener binds to.  Empty means all interfaces, which is the
+// historical behaviour.  Set with ws_set_bind_addr().
+char ws_bind_addr[64] = "";
 // ws_uri default can be changed with ws_set_uri().  For the typical expected
 // usage, the uri of an html file will be set with ws_add_httptarget_file()
 // or ws_add_httptarget_data().  This will typically be given an easy to type
@@ -359,6 +362,23 @@ int ws_set_port(int port) {
 }
 
 
+// Restrict the listener to one address.
+// This is optional, but is ignored if used after ws_init()
+// Without it the listener binds every interface.
+// Return 0 on success, -1 on failure.
+int ws_set_bind_addr(const char *addr) {
+	if (ws_listening) {
+		ws_error("WS ERROR: Ignoring ws_set_bind_addr() after ws_init()");
+		return (-1);
+	}
+	if (addr == NULL)
+		addr = "";
+	snprintf(ws_bind_addr, sizeof(ws_bind_addr), "%s", addr);
+	ws_debug("WS: WebSocket server bind address set to '%s'.", ws_bind_addr);
+	return (0);
+}
+
+
