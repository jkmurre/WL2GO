@@ -110,6 +110,7 @@ static struct option long_options[] =
 	{"ignorealsaerror", no_argument, 0, 'A'},
 	{"help",  no_argument, 0 , 'h'},
 	{"list-devices", no_argument, 0 , 1000},
+	{"hostbind", required_argument, 0 , 1001},
 	{ NULL , no_argument , NULL , no_argument }
 };
 
@@ -126,10 +127,13 @@ char HelpScreen[] =
 	"--list-devices                       List available audio devices and exit.\n"
 	"                                       Prints '#ARDOPCF-DEVICE-LIST 2', then one\n"
 	"                                       tab separated line per device:\n"
 	"                                       <CAPTURE|PLAYBACK><TAB><index><TAB><host API>\n"
 	"                                       <TAB><channels><TAB><default|-><TAB>12k=<yes|no>\n"
 	"                                       <TAB><name>.  The name is last because it is\n"
 	"                                       the only field that could contain a tab.\n"
+	"--hostbind addr                      Bind the host command and data ports to addr\n"
+	"                                       instead of all interfaces. Use 127.0.0.1 to\n"
+	"                                       accept connections only from this machine.\n"
 	"-l path or --logdir path             Path for log files\n"
 	"-H string or --hostcommands string   String of semicolon separated host commands to apply\n"
 	"                                       to ardopcf during startup, as if they had come from\n"
@@ -196,6 +200,14 @@ void processargs(int argc, char * argv[])
 			// indices this build can actually open.
 			exit(ListAudioDevices());
 
+		case 1001:
+			// Restrict the host interface to one address. Without this the
+			// listeners bind INADDR_ANY, exposing TNC control -- including
+			// transmit -- to anyone who can reach this machine.
+			strncpy(HostBindAddr, optarg, sizeof(HostBindAddr) - 1);
+			HostBindAddr[sizeof(HostBindAddr) - 1] = 0;
+			break;
+
 		case 'h':
 
 			printf("%s Version %s (https://www.github.com/pflarue/ardop)\n", ProductName, ProductVersion);
